# ---------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose to the browser. Used by the admin client
# for privileged operations (media library, role management, metrics).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------
# Site
# ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------
# Integrations
# ---------------------------------------------------------------
# Google Maps Embed API key (Contact page map)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-embed-key
# International format, digits only — used to build wa.me links
NEXT_PUBLIC_WHATSAPP_NUMBER=237677693901
